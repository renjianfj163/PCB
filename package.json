{
	"name": "pcb",
	"version": "0.1.2",
	"type": "module",
	"description": "Local shell for omp: conversation, plans and actions over omp's own RPC",
	"license": "MIT",
	"author": "PCB contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/renjianfj163/PCB.git"
	},
	"homepage": "https://github.com/renjianfj163/PCB#readme",
	"bugs": {
		"url": "https://github.com/renjianfj163/PCB/issues"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:server": "node --watch server/main.ts",
		"dev:web": "cd web && npm run dev",
		"build": "cd web && npm run build",
		"start": "node server/main.ts",
		"test": "node --test test/*.test.ts",
		"setup": "cd web && npm install",
		"check": "tsc -p tsconfig.json --noEmit && cd web && npm run check:types",
		"verify": "npm run check && npm test"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2"
	},
	"engines": {
		"node": ">=22.18"
	}
}
